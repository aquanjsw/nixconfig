[
  {
    "layer": "top",
    "position": "top",
    "modules-left": [],
    "modules-center": [],
    "modules-right": ["network", "battery", "pulseaudio", "tray", "clock"],
    "pulseaudio": {
      "tooltip-format": "{desc}",
      "format": "{icon} {volume}%",
      "format-icons": {
        "default": [""],
        "headset": ["󰋋"]
      },
      "scroll-step": 2
    },
    "clock": {
      "format": "{:%B-%d %A %H:%M}",
      "tooltip": false
    },
    "niri/window": {
      "separate-outputs": true
    },
    "tray": {
      "spacing": 3
    },
    "network": {
      "format": "{bandwidthTotalBytes}",
      "interval": 2,
      "tooltip": false
    },
    "battery": {
      "interval": 60,
      "states": {
        "warning": 30,
        "critical": 15
      },
      "events": {
        "on-discharging-warning": "notify-send -u normal 'Low Battery'",
        "on-discharging-critical": "notify-send -u critical 'Very Low Battery'",
        "on-charging-100": "notify-send -u normal 'Battery Full!'",
        "on-discharging": "notify-send -u normal 'Power Switch' Discharging",
        "on-charging": "notify-send -u normal 'Power Switch' Charging'"
      },
      "format": "{icon}",
      "format-icons": {
        "default": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "charging": ["󰢟", "󰢜", "󰂆", "󰂇", "󰂈", "󰢝", "󰂉", "󰢞", "󰂊", "󰂋", "󰂅"]
      }
    }
  }
]
